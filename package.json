{
  "name": "trip-market-price-compare",
  "version": "0.1.0",
  "private": true,
  "description": "Compare Trip.com hotel room prices across country/region markets",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "trip-compare": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx src/cli.ts",
    "api": "tsx src/api/server.ts",
    "start": "node dist/api/server.js",
    "doctor": "tsx src/doctor.ts",
    "chrome": "node scripts/launch-chrome.mjs",
    "share": "node scripts/share.mjs"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.2.1",
    "playwright-core": "^1.50.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
